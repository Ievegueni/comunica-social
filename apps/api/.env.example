# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comunica_social
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5173/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
